{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionist.local/contracts/resource-budget.schema.json",
  "title": "Actionist Block Host resource budget",
  "description": "A fail-closed, product-agnostic resource budget for one host binding or representative runtime trace. Numeric values may be measured receipts or explicitly labelled design fixtures; arithmetic is verified outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "budget_id",
    "measurement_status",
    "basis",
    "scope",
    "capacity",
    "headroom",
    "modules",
    "runtime_units",
    "connection_pools",
    "queues",
    "managed_dependencies",
    "calculation",
    "value_matrix"
  ],
  "properties": {
    "schema_version": {
      "const": "actionist.block-host.resource-budget.v1"
    },
    "budget_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "measurement_status": {
      "enum": ["measured", "design_estimate", "unknown"]
    },
    "basis": {
      "enum": ["measured_precedent", "inference", "unknown"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_kind", "environment", "tenant_count", "workspace_count", "concurrency", "notes"],
      "properties": {
        "trace_kind": {
          "enum": ["service_trace", "module_trace", "engine_trace"]
        },
        "environment": {
          "enum": ["development", "preview", "production"]
        },
        "tenant_count": {
          "type": "integer",
          "minimum": 0
        },
        "workspace_count": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capacity": {
      "$ref": "#/$defs/capacity"
    },
    "headroom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millicores", "ram_mb", "connections", "storage_mb"],
      "properties": {
        "cpu_millicores": {
          "type": "integer",
          "minimum": 0
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "runtime_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtime_unit"
      }
    },
    "connection_pools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection_pool"
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queue"
      }
    },
    "managed_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/managed_dependency"
      }
    },
    "calculation": {
      "$ref": "#/$defs/calculation"
    },
    "value_matrix": {
      "$ref": "#/$defs/value_matrix"
    }
  },
  "$defs": {
    "basis": {
      "enum": ["measured_precedent", "inference", "unknown"]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millicores", "ram_mb", "persistent_storage_mb", "max_connections", "process_limit"],
      "properties": {
        "cpu_millicores": {
          "type": "integer",
          "minimum": 1
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 1
        },
        "persistent_storage_mb": {
          "type": "integer",
          "minimum": 1
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1
        },
        "process_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "runtime_profile", "runtime_unit_id", "data_owner", "budget_basis", "evidence_refs"],
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "runtime_profile": {
          "enum": ["package_in_host", "microfrontend", "sidecar_service", "worker_pool", "scheduled_job"]
        },
        "runtime_unit_id": {
          "type": ["string", "null"]
        },
        "data_owner": {
          "type": "string",
          "minLength": 1
        },
        "budget_basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "runtime_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "unit_kind",
        "runtime_profile",
        "module_ids",
        "replicas",
        "processes_per_replica",
        "baseline_ram_mb_per_process",
        "peak_ram_mb_per_process",
        "idle_cpu_millicores_per_process",
        "peak_cpu_millicores_per_process",
        "persistent_storage_mb_per_replica",
        "ephemeral_storage_mb_per_replica",
        "concurrency",
        "connection_pool_id",
        "budget_basis",
        "evidence_refs"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "unit_kind": {
          "enum": ["host_web", "static_asset", "sidecar_service", "worker_pool", "scheduler"]
        },
        "runtime_profile": {
          "enum": ["package_in_host", "microfrontend", "sidecar_service", "worker_pool", "scheduled_job"]
        },
        "module_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "processes_per_replica": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_ram_mb_per_process": {
          "type": "integer",
          "minimum": 0
        },
        "peak_ram_mb_per_process": {
          "type": "integer",
          "minimum": 0
        },
        "idle_cpu_millicores_per_process": {
          "type": "integer",
          "minimum": 0
        },
        "peak_cpu_millicores_per_process": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_storage_mb_per_replica": {
          "type": "integer",
          "minimum": 0
        },
        "ephemeral_storage_mb_per_replica": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 0
        },
        "connection_pool_id": {
          "type": ["string", "null"]
        },
        "budget_basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "connection_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_id", "runtime_unit_id", "mode", "min_connections", "max_connections", "budget_basis", "evidence_refs"],
      "properties": {
        "pool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "runtime_unit_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "mode": {
          "enum": ["transaction", "session", "external_api_pool"]
        },
        "min_connections": {
          "type": "integer",
          "minimum": 0
        },
        "max_connections": {
          "type": "integer",
          "minimum": 0
        },
        "budget_basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "pool_id", "max_inflight", "retry_limit", "lease_timeout_ms", "job_memory_class", "side_effect_class", "budget_basis", "evidence_refs"],
      "properties": {
        "queue_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "pool_id": {
          "type": ["string", "null"]
        },
        "max_inflight": {
          "type": "integer",
          "minimum": 0
        },
        "retry_limit": {
          "type": "integer",
          "minimum": 0
        },
        "lease_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "job_memory_class": {
          "enum": ["small", "medium", "large", "unknown"]
        },
        "side_effect_class": {
          "enum": ["none", "read", "write", "message", "deploy"]
        },
        "budget_basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "managed_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "kind", "counted_in_process_total", "capacity_status", "budget_basis", "owner", "notes"],
      "properties": {
        "dependency_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "kind": {
          "enum": ["postgres", "redis", "object_storage", "telemetry", "external_provider"]
        },
        "counted_in_process_total": {
          "const": false
        },
        "capacity_status": {
          "enum": ["measured", "plan_specific", "unmeasured", "not_applicable"]
        },
        "budget_basis": {
          "$ref": "#/$defs/basis"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_total",
        "baseline_ram_mb",
        "peak_ram_mb",
        "idle_cpu_millicores",
        "peak_cpu_millicores",
        "peak_connections",
        "persistent_storage_mb",
        "ephemeral_storage_mb",
        "storage_required_mb",
        "queue_inflight_peak",
        "worker_concurrency_envelope",
        "formulas",
        "capacity_checks"
      ],
      "properties": {
        "process_total": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "peak_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "idle_cpu_millicores": {
          "type": "integer",
          "minimum": 0
        },
        "peak_cpu_millicores": {
          "type": "integer",
          "minimum": 0
        },
        "peak_connections": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_storage_mb": {
          "type": "integer",
          "minimum": 0
        },
        "ephemeral_storage_mb": {
          "type": "integer",
          "minimum": 0
        },
        "storage_required_mb": {
          "type": "integer",
          "minimum": 0
        },
        "queue_inflight_peak": {
          "type": "integer",
          "minimum": 0
        },
        "worker_concurrency_envelope": {
          "type": "integer",
          "minimum": 0
        },
        "formulas": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capacity_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "ram", "connections", "processes", "storage", "queues"],
          "properties": {
            "cpu": { "type": "boolean" },
            "ram": { "type": "boolean" },
            "connections": { "type": "boolean" },
            "processes": { "type": "boolean" },
            "storage": { "type": "boolean" },
            "queues": { "type": "boolean" }
          }
        }
      }
    },
    "value_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula_version", "raw_inputs", "normalized_factors", "confidence", "decision", "refusal_conditions", "ui_contract"],
      "properties": {
        "formula_version": {
          "const": "actionist.block-host.value-matrix.v1"
        },
        "raw_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_total",
            "idle_ram_mb",
            "active_ram_mb",
            "physical_database_count",
            "sidecar_process_count",
            "managed_dependency_count",
            "peak_connections",
            "migration_owner_count",
            "dynamic_schema_owner_count",
            "worker_pool_count",
            "queue_count",
            "queue_utilization",
            "independent_release_units",
            "irreversible_side_effect_classes",
            "known_recovery_gaps"
          ],
          "properties": {
            "process_total": { "type": "integer", "minimum": 0 },
            "idle_ram_mb": { "type": "integer", "minimum": 0 },
            "active_ram_mb": { "type": "integer", "minimum": 0 },
            "physical_database_count": { "type": "integer", "minimum": 0 },
            "sidecar_process_count": { "type": "integer", "minimum": 0 },
            "managed_dependency_count": { "type": "integer", "minimum": 0 },
            "peak_connections": { "type": "integer", "minimum": 0 },
            "migration_owner_count": { "type": "integer", "minimum": 0 },
            "dynamic_schema_owner_count": { "type": "integer", "minimum": 0 },
            "worker_pool_count": { "type": "integer", "minimum": 0 },
            "queue_count": { "type": "integer", "minimum": 0 },
            "queue_utilization": { "type": "number", "minimum": 0, "maximum": 1 },
            "independent_release_units": { "type": "integer", "minimum": 0 },
            "irreversible_side_effect_classes": { "type": "integer", "minimum": 0 },
            "known_recovery_gaps": { "type": "integer", "minimum": 0 }
          }
        },
        "normalized_factors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process_burden", "idle_memory_burden", "active_memory_burden", "database_burden", "service_burden", "connection_burden", "migration_ownership_burden", "worker_burden", "upgrade_burden", "rollback_burden"],
          "properties": {
            "process_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "idle_memory_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "active_memory_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "database_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "service_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "connection_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "migration_ownership_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "worker_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "upgrade_burden": { "type": "number", "minimum": 0, "maximum": 5 },
            "rollback_burden": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall", "per_factor", "unknown_factors"],
          "properties": {
            "overall": { "type": "number", "minimum": 0, "maximum": 1 },
            "per_factor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["process_burden", "idle_memory_burden", "active_memory_burden", "database_burden", "service_burden", "connection_burden", "migration_ownership_burden", "worker_burden", "upgrade_burden", "rollback_burden"],
              "properties": {
                "process_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "idle_memory_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "active_memory_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "database_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "service_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "connection_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "migration_ownership_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "worker_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "upgrade_burden": { "type": "number", "minimum": 0, "maximum": 1 },
                "rollback_burden": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "unknown_factors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "decision": {
          "enum": ["eligible", "review_required", "refuse_for_pilot"]
        },
        "refusal_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/refusal_condition"
          }
        },
        "ui_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hide_allowed", "display_raw_inputs", "display_normalized_factors", "display_confidence", "display_refusal_conditions", "machine_decision_source"],
          "properties": {
            "hide_allowed": { "const": false },
            "display_raw_inputs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "display_normalized_factors": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "display_confidence": { "const": true },
            "display_refusal_conditions": { "const": true },
            "machine_decision_source": { "const": "value_matrix" }
          }
        }
      }
    },
    "refusal_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "triggered", "rule", "evidence_refs"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(REFUSE|REVIEW)-[A-Z0-9-]+$"
        },
        "severity": {
          "enum": ["hard", "soft"]
        },
        "triggered": {
          "type": "boolean"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
