{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "actionist.release-manifest.v1",
  "title": "Actionist ReleaseManifest",
  "description": "Release record for one composed application. Sprint 2 P14 proposal. Research only; UNEXECUTED; NOT_ADMITTED.",
  "type": "object",
  "required": [
    "schema_version",
    "composition_id",
    "composition_version",
    "environment",
    "capabilities",
    "rollback_plan",
    "composition_horizon_seconds",
    "declared_support_window_seconds",
    "non_recoverable_effects",
    "qualification",
    "approval",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "actionist.release-manifest.v1" },
    "composition_id": { "type": "string", "minLength": 1 },
    "composition_version": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["preview", "staging", "production"] },
    "released_at": { "type": "string", "format": "date-time" },

    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "capability_version",
          "runtime_profile",
          "attribution_class",
          "pin",
          "health_assertion"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable across redeploy. Not a display name, not a URL. Emitted on every span, log, metric and error."
          },
          "capability_version": { "type": "string", "minLength": 1 },
          "runtime_profile": {
            "enum": ["package-in-host", "microfrontend", "sidecar-service", "worker", "scheduled-job"]
          },
          "attribution_class": {
            "enum": ["dependency", "service", "endpoint", "deploy", "none"],
            "description": "Verified by induced-failure test at qualification, never self-declared. 'none' is not admissible. P15 may only act on signals at or below this class."
          },
          "attribution_class_verified_by": {
            "type": "string",
            "description": "Reference to the induced-failure receipt establishing the class."
          },
          "owner": {
            "type": "string",
            "description": "Ownership metadata resolvable from capability_id. Admission-blocking."
          },
          "pin": {
            "type": "object",
            "required": ["digest", "retention_expires_at"],
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string",
                "minLength": 1,
                "description": "Content digest. The rollback target. A tag is never the rollback target."
              },
              "tag": { "type": "string", "description": "Human-facing only. Not a pin." },
              "retention_expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "Actionist-owned retention. MUST be >= composition horizon expiry."
              },
              "retention_owner": { "enum": ["actionist", "third_party"], "default": "actionist" }
            }
          },
          "health_assertion": {
            "type": "object",
            "required": ["kind", "expression", "machine_readable_fail"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["threshold", "success_condition", "freshness"] },
              "expression": { "type": "string", "minLength": 1 },
              "machine_readable_fail": {
                "type": "boolean",
                "const": true,
                "description": "A check that does not affect exit status is not an assertion."
              },
              "baseline_required": {
                "type": "boolean",
                "description": "If true, unavailable on first release (no historical baseline); falls back to threshold + human decision."
              }
            }
          },
          "instrumentable": { "type": "boolean" },
          "owns_durable_store": { "type": "boolean" },
          "owns_migrations": { "type": "boolean" }
        }
      }
    },

    "rollback_plan": {
      "type": "object",
      "required": ["objects", "order", "rehearsal"],
      "additionalProperties": false,
      "description": "Never a boolean. A composition has multiple rollback objects and reverting one does not revert the others.",
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["object_class", "mechanism", "horizon_seconds", "horizon_owner"],
            "additionalProperties": false,
            "properties": {
              "object_class": {
                "enum": [
                  "code_artifact", "config", "secrets", "schema",
                  "data", "donor_revision", "surface_route", "connector_state"
                ]
              },
              "capability_id": { "type": "string" },
              "mechanism": { "type": "string", "minLength": 1 },
              "horizon_seconds": {
                "type": "number",
                "minimum": 0,
                "description": "0 means uncomputable. Unknown is not optimistic; 0 forces NO_SHIP by arithmetic."
              },
              "horizon_owner": { "enum": ["actionist", "donor", "engine", "third_party", "shared"] },
              "rehearsal_receipt": { "type": "string" }
            }
          }
        },
        "order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Execution order. Reverting objects out of order corrupts state."
        },
        "rehearsal": {
          "type": "array",
          "description": "Per object class, not per release. Unrehearsed rollback blocks release.",
          "items": {
            "type": "object",
            "required": ["object_class", "executed_at", "pre_checksum", "post_checksum", "elapsed_seconds", "parity"],
            "additionalProperties": false,
            "properties": {
              "object_class": { "type": "string" },
              "executed_at": { "type": "string", "format": "date-time" },
              "pre_checksum": { "type": "string" },
              "post_checksum": { "type": "string" },
              "elapsed_seconds": { "type": "number", "minimum": 0 },
              "parity": { "enum": ["restored", "unrestored", "partial"] },
              "mechanism_unchanged_since": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },

    "composition_horizon_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "min(horizon) across all rollback objects. Computed at release time, not discovered during an incident."
    },
    "declared_support_window_seconds": { "type": "number", "minimum": 0 },

    "non_recoverable_effects": {
      "type": "array",
      "description": "Effects that were never recoverable. Held outside the horizon calculation so they do not zero every release.",
      "items": {
        "type": "object",
        "required": ["capability_id", "effect", "disposition"],
        "additionalProperties": false,
        "properties": {
          "capability_id": { "type": "string" },
          "effect": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["compensating_action", "accepted"] },
          "compensating_action": { "type": "string" },
          "accepted_by": { "type": "string" }
        }
      }
    },

    "qualification": {
      "type": "object",
      "required": ["dossier_ref", "tier", "tier_rule", "workflow_acceptance"],
      "additionalProperties": false,
      "properties": {
        "dossier_ref": { "type": "string" },
        "tier": { "enum": ["T1", "T2", "T3", "T4"] },
        "tier_rule": {
          "const": "minimum_across_families",
          "description": "Evidence tier is the minimum across families, never an average."
        },
        "workflow_acceptance": {
          "enum": ["pass", "fail", "inconclusive", "not_run"],
          "description": "A passing build is not client workflow proof. Composition-level gate above the build gate."
        },
        "cross_tenant_leakage": {
          "enum": ["none_observed", "observed"],
          "description": "'observed' is NO_SHIP in every profile with a tenant boundary. Never tiered, never traded."
        }
      }
    },

    "approval": {
      "type": "object",
      "required": ["policy_pass", "human_approver", "approved_at"],
      "additionalProperties": false,
      "description": "Policy pass and human approval are both required; neither substitutes for the other.",
      "properties": {
        "policy_pass": { "type": "boolean" },
        "human_approver": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "horizon_override": {
          "type": "object",
          "description": "Present only when composition_horizon < declared_support_window. Named human authority required.",
          "required": ["authorized_by", "rationale"],
          "additionalProperties": false,
          "properties": {
            "authorized_by": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      }
    },

    "obligations": {
      "type": "array",
      "description": "Licence notices and source-offer obligations carried as release gates. Legal interpretation is out of this lane's scope.",
      "items": {
        "type": "object",
        "required": ["capability_id", "obligation", "satisfied"],
        "additionalProperties": false,
        "properties": {
          "capability_id": { "type": "string" },
          "obligation": { "type": "string" },
          "satisfied": { "type": "boolean" },
          "evidence_ref": { "type": "string" }
        }
      }
    },

    "status": {
      "enum": ["DRAFT", "REFUSED", "APPROVED", "RELEASED", "ROLLED_BACK"],
      "description": "REFUSED covers horizon shortfall (H-2) and uncomputable horizon (H-3) without override."
    },
    "research_only": { "type": "boolean", "const": true },
    "execution_status": { "const": "UNEXECUTED" },
    "admission_status": { "const": "NOT_ADMITTED" }
  }
}
