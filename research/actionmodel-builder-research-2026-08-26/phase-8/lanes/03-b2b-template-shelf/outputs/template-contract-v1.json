{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siso:actionist-builder:template-contract:v1",
  "title": "Actionist B2B Template Contract v1",
  "description": "Research-only contract for an APP-LEVEL template (a deployable B2B starter), one layer above the Block Contract v1 (siso:actionist-builder:block-contract:v1). A template is a composition envelope: it declares an archetype, the industry variants it can serve, the blocks it contains or requires, and the tenancy/auth/data assumptions a composed app inherits. Satisfying this schema is NOT admission, NOT a rights clearance, and NOT a capability claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "template_id",
    "archetype",
    "status",
    "description",
    "research_boundary",
    "source",
    "identity",
    "rights",
    "stack",
    "tenancy",
    "auth",
    "data",
    "included_blocks",
    "required_blocks",
    "industry_variants",
    "atom_coverage",
    "missing_gates",
    "disposition",
    "evidence"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "template_id": {
      "type": "string",
      "pattern": "^tpl/[a-z0-9-]+/[a-z0-9-]+@1\\.[0-9]+\\.[0-9]+$",
      "description": "tpl/<archetype>/<slug>@1.x.y"
    },
    "archetype": {
      "enum": [
        "crm",
        "case_workflow",
        "portal",
        "finance_ops",
        "inventory",
        "scheduling",
        "support_desk",
        "field_operations",
        "learning_content",
        "marketplace"
      ]
    },
    "status": {
      "enum": ["discovered", "candidate", "reference_only", "hold", "rejected", "not_admitted"],
      "description": "Mirrors a bounded subset of block-contract statuses. 'admitted' is deliberately absent: no template may be admitted by this contract."
    },
    "description": { "type": "string", "minLength": 1 },

    "research_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "implementation_authorized",
        "admission_authorized",
        "source_cloned",
        "source_executed",
        "license_scan_performed",
        "runtime_behavior_claimed",
        "deployment_claimed",
        "client_data_used"
      ],
      "properties": {
        "mode": { "const": "research_only" },
        "implementation_authorized": { "const": false },
        "admission_authorized": { "const": false },
        "source_cloned": { "const": false },
        "source_executed": { "const": false },
        "license_scan_performed": { "const": false },
        "runtime_behavior_claimed": { "const": false },
        "deployment_claimed": { "const": false },
        "client_data_used": { "const": false }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "first_party_url", "observed_on"],
      "properties": {
        "kind": { "enum": ["github_repository", "vendor_docs", "local_asset", "unknown"] },
        "first_party_url": { "type": "string", "minLength": 1 },
        "observed_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "discovery_lane": { "type": "string" },
        "prior_sweep_ref": {
          "type": "string",
          "description": "Path to the prior sweep record this row inherits metadata from, if any. Prevents silent re-derivation."
        }
      }
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinned", "default_branch", "commit_sha", "pin_note"],
      "properties": {
        "pinned": { "type": "boolean" },
        "default_branch": { "type": "string" },
        "commit_sha": {
          "type": "string",
          "description": "Exact commit the record describes, or 'unknown' when unpinned. An unpinned template is a moving target and MUST NOT reach disposition 'candidate' without a pin."
        },
        "pin_note": { "type": "string" }
      }
    },

    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_license", "license_evidence", "transitive_deps_reviewed", "trademark_brand_risk", "rights_state"],
      "properties": {
        "declared_license": { "type": "string", "description": "SPDX id as declared by the repository host, or 'unknown'." },
        "license_evidence": { "enum": ["first_party_api", "repo_license_file", "readme_claim", "unknown"] },
        "transitive_deps_reviewed": { "const": false },
        "trademark_brand_risk": { "enum": ["named_brand_present", "none_observed", "unknown"] },
        "rights_state": {
          "enum": ["permissive_declared_unverified", "copyleft_declared", "restricted", "no_license", "unknown"],
          "description": "A declared permissive top-level license never clears the dependency tree. 'verified' is not an available value in v1."
        }
      }
    },

    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "framework", "datastore", "evidence_class"],
      "properties": {
        "language": { "type": "string" },
        "framework": { "type": "string" },
        "datastore": { "type": "string" },
        "runtime_target": { "type": "string" },
        "evidence_class": { "enum": ["E", "D", "I", "U"] }
      }
    },

    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "isolation_boundary", "evidence_class"],
      "properties": {
        "model": { "enum": ["multi_tenant_shared_db", "multi_tenant_schema", "multi_tenant_db_per_tenant", "single_tenant", "unclear", "unknown"] },
        "isolation_boundary": { "type": "string", "description": "Where tenant separation is asserted (row policy, schema, deployment), or 'unknown'." },
        "cross_tenant_leak_test": { "const": "unexecuted" },
        "evidence_class": { "enum": ["E", "D", "I", "U"] }
      }
    },

    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "rbac_model", "evidence_class"],
      "properties": {
        "mechanism": { "type": "string", "description": "Declared auth mechanism, or 'unknown'." },
        "rbac_model": { "enum": ["roles_declared", "permissions_declared", "none_observed", "unknown"] },
        "sso_saml_scim": { "enum": ["declared", "absent", "unknown"] },
        "evidence_class": { "enum": ["E", "D", "I", "U"] }
      }
    },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_entities", "source_of_truth_assumption", "migration_story", "evidence_class"],
      "properties": {
        "core_entities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "source_of_truth_assumption": {
          "type": "string",
          "description": "Whether the template assumes it owns the record or mirrors an upstream system. Determines whether an Actionist read-only atom can sit on it."
        },
        "migration_story": { "enum": ["declared", "absent", "unknown"] },
        "residency_pii_class": { "enum": ["regulated_likely", "standard_business", "unknown"] },
        "evidence_class": { "enum": ["E", "D", "I", "U"] }
      }
    },

    "included_blocks": {
      "type": "array",
      "description": "Capability slices the template appears to ship. Each is a CLAIM about the template, not an admitted block. Empty array is legal and honest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice", "evidence_class"],
        "properties": {
          "slice": { "type": "string" },
          "maps_to_atom": { "type": "string" },
          "evidence_class": { "enum": ["E", "D", "I", "U"] }
        }
      }
    },

    "required_blocks": {
      "type": "array",
      "description": "Capability slices a composed app of this archetype needs that the template does NOT supply. This is the shelf's build-vs-borrow signal.",
      "items": { "type": "string" }
    },

    "industry_variants": {
      "type": "array",
      "description": "Which of the 17 catalogue industries this template could serve, and what changes per variant.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["industry_id", "variant_delta", "fit"],
        "properties": {
          "industry_id": { "type": "string" },
          "variant_delta": { "type": "string", "description": "What must change: entities, states, terminology, compliance." },
          "fit": { "enum": ["direct", "adaptable", "poor", "unknown"] }
        }
      }
    },

    "atom_coverage": {
      "type": "array",
      "description": "Which of the 12 baseline atoms this template's surface could host. Hosting is not performing.",
      "items": { "type": "string" }
    },

    "missing_gates": {
      "type": "array",
      "minItems": 1,
      "description": "Named unresolved gates. MUST be non-empty in v1: no template in this phase has cleared rights, runtime, eval, or economics.",
      "items": {
        "enum": [
          "rights_dependency_tree",
          "license_scan",
          "sbom",
          "build_reproducibility",
          "runtime_behavior",
          "tenancy_isolation_proof",
          "auth_authority_model",
          "data_migration",
          "visual_pipeline_fit",
          "maintenance_owner",
          "rollback",
          "evaluation_suite",
          "economics",
          "client_legal_review",
          "accessibility",
          "security_review"
        ]
      }
    },

    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason", "blocking_gate"],
      "properties": {
        "value": { "enum": ["candidate", "reference", "hold"] },
        "reason": { "type": "string", "minLength": 1 },
        "blocking_gate": { "type": "string", "description": "The single gate that most blocks promotion, or 'none_single'." }
      }
    },

    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "class", "source", "observed_on"],
        "properties": {
          "claim": { "type": "string" },
          "class": { "enum": ["E", "D", "I", "U"] },
          "source": { "type": "string" },
          "observed_on": { "type": "string" }
        }
      }
    }
  },

  "$comment": "Promotion rule (research-only, unexecuted): disposition 'candidate' requires identity.pinned=true, rights.rights_state != 'unknown', tenancy.model != 'unknown', and at least one E-class evidence row. 'reference' means read the design, do not take the code. 'hold' means an identity, rights, or archetype-fit question blocks even reference use."
}
