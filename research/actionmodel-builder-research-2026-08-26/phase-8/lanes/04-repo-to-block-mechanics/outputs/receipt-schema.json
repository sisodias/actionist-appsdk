{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siso:actionist-builder:repo-to-block-receipt:v1",
  "title": "Repo-to-block conversion receipt v1",
  "description": "Research-only receipt shape for the ten-stage repo-to-block conversion pipeline. It EXTENDS Phase-2 Block Contract v1 $defs.evidence_receipt; it does not replace it. All fourteen contract receipt_type values are preserved unchanged and three additions are PROPOSED to lane 01, which owns the contract. This schema admits no block and authorizes no implementation.",
  "x-artifact-id": "P8-R2B-RECEIPT-SCHEMA-001",
  "x-lane": "P8-REPO-TO-BLOCK-MECHANICS",
  "x-observed": "2026-08-27",
  "x-research-boundary": {
    "research_only": true,
    "implementation_authorized": false,
    "execution_status": "UNEXECUTED",
    "admission_status": "NOT_ADMITTED",
    "admitted_blocks": 0,
    "source_cloned": false,
    "source_copied": false,
    "source_executed": false,
    "build_run": false,
    "sandbox_run": false,
    "license_scan_run": false,
    "sbom_generated": false,
    "benchmark_run": false,
    "deployment_run": false,
    "client_data_accessed": false
  },
  "x-source-basis": [
    "phase-2/outputs/block-contract-v1.json ($defs.evidence_receipt, $defs.transformation, $defs.source, $defs.rights)",
    "phase-2/outputs/evaluation-and-admission-plan.md (G1-G7 gate register)",
    "phase-4/outputs/pilot-receipt-runbook.md (evidence classes E/D/I/U; eight UI states)"
  ],
  "x-contract-inheritance": {
    "base_contract": "siso:actionist-builder:block-contract:v1",
    "base_def": "$defs.evidence_receipt",
    "inherited_required_fields": [
      "receipt_id",
      "receipt_type",
      "status",
      "evidence_class",
      "observed_at",
      "method",
      "expected",
      "observed",
      "artifact_digest",
      "source_refs",
      "owner",
      "retention",
      "limitations",
      "falsifier"
    ],
    "inherited_receipt_types": [
      "schema_valid",
      "source_rights",
      "transform_boundary",
      "ports_contract",
      "state_machine",
      "authority_consent",
      "tenancy_isolation",
      "eval_fixture",
      "ui_accessibility",
      "security_egress",
      "build_runtime",
      "recovery_rollback",
      "cost_maintenance",
      "human_admission"
    ],
    "proposed_additional_receipt_types": [
      {
        "type": "source_identity",
        "stage": 0,
        "rationale": "Stage 0 is the precondition for every other receipt, yet no contract receipt_type records it. Its absence is why phase-7 could record repositories with immutable_commit_or_tag NOT_CAPTURED without any receipt registering the omission.",
        "authority": "lane 01 (P8-UNIVERSAL-BLOCK-FRAMEWORK)"
      },
      {
        "type": "dependency_closure",
        "stage": 3,
        "rationale": "G2 treats 'missing SBOM component' as a kill condition, but no receipt_type carries the closure result. Today it would hide inside source_rights, conflating what a candidate depends on with what it is licensed as.",
        "authority": "lane 01 (P8-UNIVERSAL-BLOCK-FRAMEWORK)"
      },
      {
        "type": "shape_decision",
        "stage": 2,
        "rationale": "The S1-S4 choice fixes rights exposure and maintenance burden for the block's whole life and is currently unrecorded.",
        "authority": "lane 01 (P8-UNIVERSAL-BLOCK-FRAMEWORK)"
      }
    ],
    "optional_refinement": {
      "proposal": "split transform_boundary into boundary_computed (Stage 4) and transform_applied (Stage 6)",
      "rationale": "Stage 4 is DET and Stage 6 is SEMI; different determinism classes should not share one receipt type.",
      "status": "optional; not required for the pipeline to function"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_type",
    "stage",
    "status",
    "evidence_class",
    "observed_at",
    "method",
    "expected",
    "observed",
    "artifact_digest",
    "source_refs",
    "owner",
    "retention",
    "limitations",
    "falsifier",
    "determinism",
    "research_boundary"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^RCPT-[A-Z0-9-]+$",
      "description": "Matches Block Contract v1 evidence_receipt.receipt_id pattern unchanged."
    },
    "receipt_type": {
      "description": "Contract v1's 14 values plus 3 proposed additions and 1 refinement.",
      "enum": [
        "schema_valid",
        "source_rights",
        "transform_boundary",
        "ports_contract",
        "state_machine",
        "authority_consent",
        "tenancy_isolation",
        "eval_fixture",
        "ui_accessibility",
        "security_egress",
        "build_runtime",
        "recovery_rollback",
        "cost_maintenance",
        "human_admission",
        "source_identity",
        "dependency_closure",
        "shape_decision",
        "transform_applied"
      ]
    },
    "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Pipeline stage 0-10. Stage 10 (admission) is outside this lane's authority."
    },
    "status": {
      "enum": [
        "pass",
        "not_run",
        "unknown",
        "fail",
        "not_applicable",
        "superseded"
      ],
      "description": "Inherited unchanged. Current value for every receipt produced by this lane is not_run."
    },
    "evidence_class": {
      "enum": [
        "E",
        "D",
        "I",
        "U"
      ],
      "description": "E direct observation; D documented design; I inference needing a falsifier; U unknown/absent/gated/unexecuted."
    },
    "determinism": {
      "enum": [
        "DET",
        "DET-ENV",
        "SEMI",
        "HUM"
      ],
      "description": "DET byte-reproducible; DET-ENV reproducible only against a pinned environment; SEMI mechanically computable but human-thresholded; HUM irreducibly a named human judgment."
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1,
      "description": "For an unexecuted receipt this states the absence explicitly; never a substituted success value."
    },
    "artifact_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Named accountable person, or the literal UNASSIGNED. UNASSIGNED is a blocker, not a default."
    },
    "retention": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsifier": {
      "type": "string",
      "minLength": 1,
      "description": "A concrete observation that would refute this receipt. Required on every receipt."
    },
    "negative_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Negative-path code from repo-to-block-pipeline.md section 5, e.g. N-RIGHTS-01.",
      "pattern": "^N-[A-Z]+-[0-9]{2}$"
    },
    "terminal_state": {
      "type": [
        "string",
        "null"
      ],
      "description": "Resulting Block Contract v1 status. This lane adds no new lifecycle states.",
      "enum": [
        "discovered",
        "candidate",
        "quarantined",
        "converting",
        "proof_pending",
        "admission_review",
        "not_admitted",
        "held",
        "admitted",
        "released",
        "deprecated",
        "rejected",
        "revoked",
        "rolled_back",
        "reference_only",
        null
      ]
    },
    "source_shape": {
      "type": [
        "string",
        "null"
      ],
      "description": "S1 intact package; S2 service/runtime; S3 bounded code slice; S4 reference-only reimplementation.",
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        null
      ]
    },
    "gate_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^G[1-7]$",
      "description": "Phase-2 gate register reference, preserved so Phase-8 receipts remain comparable."
    },
    "research_boundary": {
      "$ref": "#/$defs/research_boundary"
    },
    "stage_payload": {
      "description": "Stage-specific fields. Optional; the required fields above always apply.",
      "oneOf": [
        {
          "$ref": "#/$defs/identity_payload"
        },
        {
          "$ref": "#/$defs/rights_payload"
        },
        {
          "$ref": "#/$defs/shape_payload"
        },
        {
          "$ref": "#/$defs/closure_payload"
        },
        {
          "$ref": "#/$defs/boundary_payload"
        },
        {
          "$ref": "#/$defs/transform_payload"
        },
        {
          "$ref": "#/$defs/proof_payload"
        },
        {
          "$ref": "#/$defs/maintenance_payload"
        }
      ]
    }
  },
  "$defs": {
    "research_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "implementation_authorized",
        "execution_status",
        "admission_status",
        "source_executed",
        "source_copied",
        "build_run",
        "scan_run"
      ],
      "properties": {
        "research_only": {
          "const": true
        },
        "implementation_authorized": {
          "const": false
        },
        "execution_status": {
          "const": "UNEXECUTED"
        },
        "admission_status": {
          "const": "NOT_ADMITTED"
        },
        "source_executed": {
          "const": false
        },
        "source_copied": {
          "const": false
        },
        "build_run": {
          "const": false
        },
        "scan_run": {
          "const": false
        }
      }
    },
    "identity_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 0. Three artifacts are required together; each alone is forgeable or mutable.",
      "required": [
        "purl",
        "immutable_revision",
        "source_digest",
        "identity_status"
      ],
      "properties": {
        "purl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^pkg:[a-zA-Z0-9.+-]+/.+",
          "description": "purl per ECMA-427: scheme:type/namespace/name@version?qualifiers#subpath."
        },
        "immutable_revision": {
          "type": [
            "string",
            "null"
          ],
          "description": "Commit SHA or tag resolved to a SHA. A bare branch name is NOT an identity."
        },
        "source_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "digest_domain": {
          "enum": [
            "git_tree",
            "release_tarball",
            "file",
            "directory",
            "unknown",
            null
          ],
          "description": "Which bytes the digest covers. Undeclared domain makes the digest unverifiable."
        },
        "identity_status": {
          "enum": [
            "pinned",
            "unpinnable",
            "gated",
            "moving_target",
            "not_captured"
          ]
        },
        "attestation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Optional in-toto v1 Statement binding the identity by digest."
        }
      }
    },
    "rights_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 1. Absence of a license statement is NOASSERTION per SPDX 2.3, never permission.",
      "required": [
        "license_expression",
        "license_state",
        "notice_state",
        "obligation_owner"
      ],
      "properties": {
        "license_expression": {
          "type": [
            "string",
            "null"
          ],
          "description": "SPDX expression, or null when absent."
        },
        "license_state": {
          "enum": [
            "declared",
            "verified",
            "noassertion_absent",
            "unknown",
            "ambiguous",
            "incompatible",
            "not_applicable_synthetic"
          ],
          "description": "noassertion_absent records that no license field exists at all."
        },
        "declared_vs_concluded": {
          "type": [
            "string",
            "null"
          ],
          "description": "Records disagreement between PackageLicenseDeclared and PackageLicenseConcluded."
        },
        "notice_state": {
          "enum": [
            "present_retained",
            "present_stripped",
            "absent",
            "unknown"
          ],
          "description": "present_stripped is a hard fail: a transform manufactured a rights violation."
        },
        "package_verification_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$",
          "description": "SPDX 2.3 7.9: SHA1 over sorted file hashes, 40 lowercase hex digits."
        },
        "obligation_owner": {
          "type": "string",
          "minLength": 1
        },
        "legal_review": {
          "enum": [
            "required",
            "complete",
            "not-required",
            "not_run",
            "unknown"
          ]
        }
      }
    },
    "shape_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 2. HUM. Rejected alternatives are recorded so the decision is falsifiable.",
      "required": [
        "chosen_shape",
        "rejected_shapes",
        "rationale",
        "decider"
      ],
      "properties": {
        "chosen_shape": {
          "enum": [
            "S1",
            "S2",
            "S3",
            "S4"
          ]
        },
        "rejected_shapes": {
          "type": "array",
          "items": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decider": {
          "type": "string",
          "minLength": 1,
          "description": "Named human. UNASSIGNED blocks the stage."
        },
        "copies_source": {
          "type": "boolean",
          "description": "True only for S3. S1, S2 and S4 copy nothing."
        }
      }
    },
    "closure_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 3. Incompleteness must be stated, never rounded to a pass.",
      "required": [
        "sbom_format",
        "closure_complete",
        "component_count",
        "unresolved_components"
      ],
      "properties": {
        "sbom_format": {
          "enum": [
            "cyclonedx-1.6-json",
            "spdx-2.3",
            "none",
            null
          ]
        },
        "sbom_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "closure_complete": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null means undetermined. A null is U, not a pass."
        },
        "component_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Any entry makes this a G2 kill condition per the Phase-2 gate register."
        },
        "vendored_without_coordinate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "boundary_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 4. DET only where reachability is static and type-aware.",
      "required": [
        "parser",
        "parser_version",
        "type_aware",
        "entry_symbols",
        "reachable_spans",
        "boundary_status"
      ],
      "properties": {
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "type_aware": {
          "type": "boolean",
          "description": "False means the closure is an under-approximation: type-only imports and re-exports are missed."
        },
        "entry_symbols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reachable_spans": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escaped_spans": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Reachability outside the nominated span -> N-BOUND-01."
        },
        "dynamic_resolution_present": {
          "type": "boolean",
          "description": "True means reachability is not statically decidable; DET degrades to SEMI."
        },
        "boundary_status": {
          "enum": [
            "closed",
            "leaks",
            "undecidable",
            "unparseable"
          ]
        }
      }
    },
    "transform_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 6. Mirrors Block Contract v1 $defs.transformation field names for comparability.",
      "required": [
        "recipe_id",
        "tool_versions",
        "before_digest",
        "after_digest",
        "adaptation_log",
        "reviewer"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "before_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adaptation_log": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "change_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Changed lines over slice lines. Exceeding the policy threshold escalates to human review."
        },
        "style_preserved": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "False makes the diff unreviewable and invalidates adaptation_log as evidence."
        },
        "semantics_reviewed": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proof_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 8. Build, visual and egress are independent; none substitutes for another.",
      "required": [
        "proof_kind",
        "environment_pinned",
        "side_effect_ledger_empty"
      ],
      "properties": {
        "proof_kind": {
          "enum": [
            "build_runtime",
            "visual",
            "egress"
          ]
        },
        "environment_pinned": {
          "type": "boolean",
          "description": "False converts this receipt from evidence into anecdote."
        },
        "environment_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ui_states_exercised": {
          "type": "array",
          "items": {
            "enum": [
              "loading",
              "empty",
              "ready",
              "stale",
              "error",
              "denied",
              "review",
              "unsupported-version"
            ]
          },
          "description": "The eight states declared in the Phase-4 runbook."
        },
        "ui_states_unreachable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "A hidden error or denied state is a kill condition."
        },
        "side_effect_ledger_empty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null is U. Only an observed empty ledger passes."
        },
        "egress_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "maintenance_payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stage 9. An unowned or unrollbackable block is rejected regardless of technical quality.",
      "required": [
        "owner",
        "drift_probe",
        "rollback_tested",
        "exit_cost_state"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "drift_probe": {
          "enum": [
            "not_run",
            "clean",
            "drifted",
            "upstream_gone"
          ]
        },
        "drift_response": {
          "enum": [
            "adopt",
            "hold",
            "fork",
            "retire",
            "not_decided",
            null
          ],
          "description": "HUM. Detection is mechanical; the response is a judgment."
        },
        "sync_burden": {
          "enum": [
            "none",
            "resolver_update",
            "manual_reextraction",
            "unknown",
            null
          ],
          "description": "manual_reextraction is the S3 worst case and the main reason to prefer S1."
        },
        "rollback_tested": {
          "type": "boolean"
        },
        "rollback_parity": {
          "enum": [
            "exact",
            "mismatch",
            "not_run",
            null
          ]
        },
        "reuse_target_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reuse_actual_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "exit_cost_state": {
          "enum": [
            "bounded",
            "unbounded",
            "unknown"
          ],
          "description": "unknown is BLOCKED, never zero."
        }
      }
    }
  },
  "x-fixture": {
    "note": "Synthetic illustrative receipt. status is not_run and every boundary flag is false. It demonstrates the shape only and admits nothing.",
    "receipt": {
      "receipt_id": "RCPT-SOURCE-RIGHTS-P8R2B-FIXTURE-001",
      "receipt_type": "source_rights",
      "stage": 1,
      "status": "not_run",
      "evidence_class": "E",
      "determinism": "SEMI",
      "observed_at": "2026-08-27",
      "method": "Read local component metadata keys only. No clone, copy, execution, or license scan. Applied SPDX 2.3 rule that an omitted license field carries a meaning equivalent to NOASSERTION.",
      "expected": "A resolvable first-party license statement for the component.",
      "observed": "meta.json keys are id, componentId, authorUserId, name, demoName, description, previewUrl, installCommand, registryDependencies, isPublic, registryTeamId, registryUserId. No license field is present. isPublic true is a visibility flag, not a grant.",
      "artifact_digest": null,
      "source_refs": [
        "/Users/shaansisodia/SISO_Workspace/siso-ui-base/registry/21st/code/19077-editorial-image-hero/meta.json",
        "https://spdx.github.io/spdx-spec/v2.3/package-information/"
      ],
      "owner": "UNASSIGNED",
      "retention": "Research artifact; retained with the Phase-8 lane outputs.",
      "limitations": [
        "Registry-level terms were NOT retrieved; a registry-wide grant may exist (U).",
