{
  "id": "siso/horizon-dashboard-read@0.1.0",
  "kind": "feature",
  "provenance": {
    "source_url": "https://github.com/horizon-ui/shadcn-nextjs-boilerplate",
    "commit_sha": "efe90c62391f2d3247a5a5f0712adcad0515aba7",
    "license": "MIT",
    "copyright": "Copyright (c) 2024 Horizon UI",
    "harvested_at": "2026-08-26",
    "adaptation_log": [
      {
        "step": "extract",
        "description": "Extract the authenticated /dashboard/main page and the chart/table dashboard components; exclude chat, essay, Stripe webhook, and provider-specific app wiring.",
        "automated": false
      },
      {
        "step": "detach-wiring",
        "description": "Replace direct Supabase client queries with provider-agnostic session and read-model interfaces; retain read-only behavior and no block-owned writes.",
        "automated": false
      },
      {
        "step": "db-normalize",
        "description": "Map the source Supabase SQL read shape to the registry Postgres/Drizzle contract; tables_owned remains empty for this read-only block.",
        "automated": false
      },
      {
        "step": "tokenize-styles",
        "description": "Replace hardcoded zinc/chart values and source color literals with Actionist token slots while preserving the shadcn CSS-variable structure.",
        "automated": false
      },
      {
        "step": "interface-swap",
        "description": "Expose session-shaped auth and a dashboard read-model adapter instead of importing Supabase directly.",
        "automated": false
      }
    ]
  },
  "stack_contract": {
    "runtime": ["nextjs@15", "react@19"],
    "styling": {
      "system": "tailwind+css-vars",
      "component_library": "shadcn"
    },
    "data": {
      "dialect": "postgres",
      "orm": "drizzle",
      "tables_owned": [],
      "tables_read": ["users"]
    },
    "auth_interface": "session",
    "interfaces_required": []
  },
  "provides": {
    "routes": [
      {
        "path": "/dashboard/main",
        "kind": "page",
        "auth_required": true
      }
    ],
    "components": [
      {
        "name": "horizon-dashboard-main",
        "files": [
          "app/dashboard/main/page.tsx",
          "components/dashboard/main/index.tsx",
          "components/dashboard/main/cards/MainChart.tsx",
          "components/dashboard/main/cards/MainDashboardTable.tsx"
        ],
        "registry_dependencies": ["card", "table", "checkbox", "button"]
      }
    ],
    "migrations": [],
    "env_vars": [],
    "events": []
  },
  "requires": [],
  "tokens_consumed": [
    "color.background",
    "color.foreground",
    "color.primary",
    "color.border",
    "space.6",
    "type.body",
    "radius.md"
  ],
  "eval": {
    "build_cmd": "npm run build",
    "smoke_test": "Start the isolated host with npm run dev, authenticate with a fixture session, request /dashboard/main, and assert the chart and read-only table render with no write request.",
    "screenshot_baseline": "pending: candidate-horizon-dashboard-baseline.png"
  }
}
